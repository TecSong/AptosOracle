{
  "name": "@elizaos/plugin-aptos-oracle",
  "version": "0.1.0",
  "description": "Aptos Oracle plugin for Eliza OS",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "@elizaos/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --format esm --dts",
    "clean": "rm -rf dist",
    "watch": "tsc --watch",
    "dev": "tsup --format esm --dts --watch",
    "build:docs": "cd docs && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "eliza",
    "plugin",
    "aptos",
    "oracle",
    "move"
  ],
  "author": "Eliza OS",
  "license": "MIT",
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "22.8.4",
    "tsup": "8.3.5",
    "typescript": "5.6.3"
  },
  "peerDependencies": {
    "@elizaos/core": "workspace:*"
  }
}
